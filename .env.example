# Local user config; copy to .env, then load it into your process.
# Do not commit .env or credentials. Never give the operator bearer to a caller.
PHONEDEX_TERMINATION_URI=sips:your-trunk.example.invalid:5062
PHONEDEX_PUBLIC_IP=
PHONEDEX_MEDIA_PORT=41002
PHONEDEX_MEDIA_PORT_FORWARDED=0
PHONEDEX_CALLER_ID=
PHONEDEX_SIP_USERNAME=
PHONEDEX_SIP_PASSWORD=
PHONEDEX_GATEWAY_URL=https://your-worker.workers.dev/agent/gateway
PHONEDEX_GATEWAY_TOKEN=
PHONEDEX_ALLOWED_RECIPIENTS=
PHONEDEX_MAX_CALLS_PER_DAY=12
PHONEDEX_DATA_DIR=
PHONEDEX_BUSINESS_PROFILE=

# Text transcript destinations: off (default), local, worker, both.
# off = do not retain or upload model transcript text.
# local = write SQLite under PHONEDEX_DATA_DIR (defaults to ~/.phonedex).
# worker = send text to your own Cloudflare Worker/KV, for remote agent review.
# both = keep local SQLite and also send to Worker/KV.
# Changes apply to NEW calls only; they do not delete previously stored text.
PHONEDEX_TRANSCRIPT_MODE=off
# Local-only retention, 1..90 days; opportunistic pruning on write.
PHONEDEX_TRANSCRIPT_RETENTION_DAYS=7

# Separate optional AgentPhone Calls dashboard export for inbound calls only.
# OFF by default. Supplying these does NOT enable audio recording.
# The SIP listener must receive these variables in its own environment.
PHONEDEX_AGENTPHONE_TRANSCRIPTS_ENABLED=0
PHONEDEX_AGENTPHONE_API_KEY=
PHONEDEX_AGENTPHONE_NUMBER_ID=

# Outbound only: 'auto' waits for a voicemail beep before GPT Live speaks.
# The optional private 24 kHz mono PCM16 wake clip triggers the first reply.
PHONEDEX_VOICEMAIL_MODE=auto
PHONEDEX_MODEL_WAKE_FILE=

# Optional Jev full-call shadow observer (OFF by default).
# Backends: rules (CPU local), kev (self-hosted), jev (TypeSafe hosted).
# Sends full conversation transcript to that server; see docs/JEV_SHADOW.md.
PHONEDEX_JEV_SHADOW_ENABLED=0
PHONEDEX_JEV_SHADOW_BACKEND=rules
# For hosted Jev, use TYPESAFE_API_KEY (server-side) and no custom URL.
TYPESAFE_API_KEY=
PHONEDEX_JEV_SHADOW_URL=
PHONEDEX_JEV_SHADOW_MODEL=
PHONEDEX_JEV_SHADOW_API_KEY=
PHONEDEX_JEV_SHADOW_INTERVAL=6
PHONEDEX_JEV_SHADOW_TIMEOUT=5
PHONEDEX_JEV_SHADOW_ALLOW_REMOTE=0
